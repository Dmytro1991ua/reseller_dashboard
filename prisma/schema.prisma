generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String   // "login" | "logout"
  apiKeyHash String   // SHA-256 of the key — identifies reseller without storing plaintext
  ip         String?
  createdAt  DateTime @default(now())

  @@index([apiKeyHash])
  @@index([createdAt])
}
